  updatedAt                     DateTime?
}

model apar_competencies {
  id                 Int      @id @default(autoincrement())
  apar_id            String   @db.VarChar(255)
  mongo_record_id    String?  @db.VarChar(255)
  competency_index   Int?
  slNo               String?  @db.VarChar(50)
  initials           String?  @db.VarChar(255)
  competency         String?  @db.Text
  reportingAuthority Decimal? @db.Decimal(18, 4)
  source_item        Json?
  apars              apars    @relation(fields: [apar_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "apar_competencies_ibfk_1")

  @@index([apar_id], map: "apar_id")
}

model apar_tasks {
  id                Int      @id @default(autoincrement())
  apar_id           String   @db.VarChar(255)
  mongo_record_id   String?  @db.VarChar(255)
