model users {
  id                  String    @id @map("_id") @db.VarChar(255)
  username            String?   @unique(map: "UQ_USERS_USERNAME") @db.VarChar(255)
  firstName           String?   @db.VarChar(100)
  lastName            String?   @db.VarChar(100)
  phoneNumber         String?   @db.VarChar(30)
  email               String?   @unique(map: "UQ_USERS_EMAIL") @db.VarChar(255)
  password            String?   @db.VarChar(255)
  role_id             String?   @db.VarChar(255)
  empCode             String?   @db.VarChar(50)
  isActive            Boolean?
  createdAt           DateTime?
  updatedAt           DateTime?

  department_id       String?   @db.VarChar(255)
  profilePic          String?   @db.VarChar(500)
  refreshToken        String?   @db.Text
  resetPasswordToken  String?   @db.VarChar(255)
  resetPasswordExpire DateTime? @db.DateTime(3)

  emailVerified       Boolean?  @default(false)
  otp                 String?   @db.VarChar(255)
  otpExpiry           DateTime? @db.DateTime(3)
}
