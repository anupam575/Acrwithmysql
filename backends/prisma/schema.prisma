generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model acceptancesections {
  id                                String    @id @map("_id") @db.VarChar(255)
  employeeId                        String?   @db.VarChar(255)
  reviewingOfficerId                String?   @db.VarChar(255)
  acceptingAuthorityNameDesignation String?   @db.VarChar(500)
  agreedWithRemarks                 String?   @db.LongText
  currentFinancialYear              String?   @db.VarChar(50)
  differenceOpinion                 String?   @db.LongText
  overallGrade                      Decimal?  @db.Decimal(18, 4)
  overallGradeConsistent            String?   @db.VarChar(255)
  officerSignature_url              String?   @db.Text
  officerSignature_size             BigInt?
  officerSignature_mimeType         String?   @db.VarChar(255)
  officerSignature_public_id        String?   @db.Text
  officerSignature_originalName     String?   @db.VarChar(500)
  createdAt                         DateTime?
  updatedAt                         DateTime?
  v                                 Int?      @map("__v")
}

model acceptingauthorities {
  id                            String    @id @map("_id") @db.VarChar(255)
