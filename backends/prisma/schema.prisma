  initials          String?  @db.VarChar(255)
  taskName          String?  @db.Text
  weightage         Decimal? @db.Decimal(18, 4)
  reportingAbsolute Decimal? @db.Decimal(18, 4)
  reportingWeighted Decimal? @db.Decimal(18, 4)
  apars             apars    @relation(fields: [apar_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "apar_tasks_ibfk_1")

  @@index([apar_id], map: "apar_id")
}

model apars {
  id                            String              @id @map("_id") @db.VarChar(255)
  employeeId                    String?             @db.VarChar(255)
  reportingOfficerId            String?             @db.VarChar(255)
  designation                   String?             @db.VarChar(255)
  financialYear                 String?             @db.VarChar(50)
  section1                      String?             @db.LongText
  section2                      String?             @db.LongText
  section3                      String?             @db.LongText
  section4                      String?             @db.LongText
  section5                      String?             @db.LongText
  integrity_doubtful            Boolean?
  integrity_beyondDoubt         Boolean?
  integrity_nothingAdverse      Boolean?
  overallGrade                  Decimal?            @db.Decimal(18, 4)
  reportingDate                 DateTime?
  officerSignature_url          String?             @db.Text
  officerSignature_size         BigInt?
  officerSignature_mimeType     String?             @db.VarChar(255)
  officerSignature_public_id    String?             @db.Text
  officerSignature_originalName String?             @db.VarChar(500)
  penPicture                    String?             @db.LongText
  mou_initials                  String?             @db.VarChar(255)
  mou_weightage                 Decimal?            @db.Decimal(18, 4)
  mou_reportingAbsolute         Decimal?            @db.Decimal(18, 4)
  mou_reportingWeighted         Decimal?            @db.Decimal(18, 4)
  grandWeightage                Decimal?            @db.Decimal(18, 4)
  totalWeightage                Decimal?            @db.Decimal(18, 4)
  grandReportingAbsolute        Decimal?            @db.Decimal(18, 4)
  grandReportingWeighted        Decimal?            @db.Decimal(18, 4)
  totalReportingAbsolute        Decimal?            @db.Decimal(18, 4)
  totalReportingWeighted        Decimal?            @db.Decimal(18, 4)
  summary_total                 Decimal?            @db.Decimal(18, 4)
  summary_overall               String?             @db.VarChar(255)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  v                             Int?                @map("__v")
  section6_source               Json?
  section7_source               Json?
  summary_source                Json?
  source_document               Json?
  apar_competencies             apar_competencies[]
  apar_tasks                    apar_tasks[]
}

